# Custom Suricata Rules
# Local rules for specific environment monitoring

# Alert on ICMP to/from external net
alert icmp $HOME_NET any -> $EXTERNAL_NET any (msg:"ICMP traffic to External Network"; sid:1000001; rev:1;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"ICMP traffic from External Network"; sid:1000002; rev:1;)

# Alert on SSH on non-standard ports (if any)
alert tcp any any -> $HOME_NET !22 (msg:"SSH traffic on non-standard port"; flow:to_server,established; content:"SSH-"; fast_pattern; sid:1000003; rev:1;)

# SQL Injection Detection
alert http any any -> any any (msg:"ATTACK SQL Injection Attempt"; flow:to_server,established; content:"SELECT"; nocase; content:"FROM"; nocase; distance:0; sid:1000010; rev:1;)
alert http any any -> any any (msg:"ATTACK SQL Injection OR 1=1"; flow:to_server,established; content:"OR"; nocase; content:"1"; content:"="; content:"1"; distance:0; sid:1000011; rev:1;)

# XSS Detection
alert http any any -> any any (msg:"ATTACK XSS script tag"; flow:to_server,established; content:"<script>"; nocase; sid:1000012; rev:1;)

# Nikto Scanner Detection
# alert http any any -> any any (msg:"SCAN Nikto Web Scanner"; flow:to_server,established; http.user_agent; content:"Nikto"; sid:1000013; rev:1;)

# Directory Traversal
alert http any any -> any any (msg:"ATTACK Directory Traversal"; flow:to_server,established; content:"../"; sid:1000014; rev:1;)
