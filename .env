# Bắt buộc: mật khẩu admin cho OpenSearch (dùng cho logstash khi cần pass opensearch)
OPENSEARCH_USER=admin
OPENSEARCH_INITIAL_ADMIN_PASSWORD=123456
# Tuỳ chọn 
OPENSEARCH_URL=https://localhost:9200

# Khi chạy simulate_usecases.sh (TCP input của Logstash)
LOGSTASH_HOST=127.0.0.1
LOGSTASH_PORT=5000

# MailHog UI/API
MAILHOG_API=http://127.0.0.1:8025
